<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/player_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="#0F172A" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B30B132B" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Boomplay Circular Vinyl Turntable Album Art -->
        <androidx.cardview.widget.CardView
            android:layout_width="260dp"
            android:layout_height="260dp"
            app:cardCornerRadius="130dp"
            app:cardElevation="16dp"
            app:cardBackgroundColor="#1E293B">

            <ImageView
                android:id="@+id/player_album_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_agenda"
                android:contentDescription="@null" />

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/now_playing_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="No song playing"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/now_playing_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:text=""
            android:textColor="#94A3B8"
            android:textSize="15sp" />

        <SeekBar
            android:id="@+id/seek_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:progressTint="#00E5FF"
            android:thumbTint="#00E5FF" />

        <TextView
            android:id="@+id/time_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="0:00 / 0:00"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <!-- Playback Controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp">

            <ImageButton
                android:id="@+id/btn_prev"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@android:drawable/ic_media_previous"
                app:tint="#FFFFFF"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginEnd="20dp"
                android:contentDescription="@null" />

            <!-- Boomplay Circular Gradient Play/Pause Button -->
            <ImageButton
                android:id="@+id/btn_play_pause"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:src="@android:drawable/ic_media_play"
                app:tint="#FFFFFF"
                android:background="@drawable/bg_play_pause"
                android:contentDescription="@null" />

            <ImageButton
                android:id="@+id/btn_next"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@android:drawable/ic_media_next"
                app:tint="#FFFFFF"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginStart="20dp"
                android:contentDescription="@null" />

        </LinearLayout>

        <!-- Shuffle, Repeat, Sleep Timer Bar -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp">

            <ImageButton
                android:id="@+id/btn_shuffle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@android:drawable/ic_menu_rotate"
                app:tint="#FFFFFF"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginEnd="24dp"
                android:contentDescription="@null" />

            <ImageButton
                android:id="@+id/btn_repeat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#FFFFFF"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginEnd="24dp"
                android:contentDescription="@null" />

            <ImageButton
                android:id="@+id/btn_sleep_timer"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@android:drawable/ic_lock_idle_alarm"
                app:tint="#FFFFFF"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null" />

        </LinearLayout>

        <TextView
            android:id="@+id/sleep_timer_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="#00E5FF"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>